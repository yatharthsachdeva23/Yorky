# Gemini API Key (Required for Research, Scriptwriting & Comment Analysis)
GEMINI_API_KEY=your_gemini_api_key_here

# Hermes Model Settings (Local Ollama or Cloud OpenRouter)
HERMES_MODE=local  # Options: 'local' (Ollama hermes3) or 'cloud' (OpenRouter)
HERMES_MODEL=hermes3:latest
OPENROUTER_API_KEY=your_openrouter_api_key_if_using_cloud

# Channel Settings
CHANNEL_NAME=My YouTube Channel
